# SMTP settings used by app/api/contact/route.ts to send contact-form
# enquiries by email. No third-party email API is used — this connects
# directly to a normal SMTP mailbox using the standard email protocol.
#
# Copy this file to .env.local and fill in real values. Never commit
# .env.local (it's already covered by the repo's .gitignore `.env*` pattern).
# Never put a real password in THIS file either — it is committed to git.

# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS: the mailbox that
# authenticates and actually sends the message.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: the "From" address shown to recipients, if different from
# SMTP_USER (e.g. authenticating as a shared sending mailbox but showing
# a cleaner no-reply address as the sender). Falls back to SMTP_USER
# when left blank.
SMTP_FROM=

# Where enquiries are delivered. Defaults to the address in lib/site.ts
# if left blank.
CONTACT_TO_EMAIL=

# ---------------------------------------------------------------------
# Admin panel — /admin shows every contact-form enquiry ever received,
# stored in Postgres (Neon). Needed because Vercel's serverless functions
# have no persistent local disk — a plain file wouldn't survive.
#
# 1. In your Vercel project, go to Storage → add the "Neon" (Postgres)
#    integration. It sets DATABASE_URL (or POSTGRES_URL) automatically —
#    nothing to paste in yourself once it's connected.
#    (Or create a free database directly at neon.com and set DATABASE_URL
#    below to the connection string it gives you.)
# 2. Pick a username and password for the admin page itself — this is a
#    single shared login, not a full user-account system.
DATABASE_URL=
ADMIN_USER=
ADMIN_PASSWORD=
